+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+/**
+ * A controller to manage the Simplified/Traditional Chinese conversion mode
+ * for status bar lyrics, backed by
+ * {@link Settings.Secure#STATUS_BAR_LYRIC_TEXT_CONVERSION}.
+ *
+ * 0 = follow the original lyrics (default), 1 = always convert to
+ * Simplified, 2 = always convert to Traditional. The SystemUI side observes
+ * this setting live; the mode takes effect from the next lyric line.
+ */
+public class StatusBarLyricTextConversionPreferenceController extends BasePreferenceController
+        implements PreferenceControllerMixin, Preference.OnPreferenceChangeListener {
+
+    public StatusBarLyricTextConversionPreferenceController(Context context,
+            String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    public StatusBarLyricTextConversionPreferenceController(Context context) {
+        super(context, Settings.Secure.STATUS_BAR_LYRIC_TEXT_CONVERSION);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+
+        final ListPreference preference = screen.findPreference(getPreferenceKey());
+        if (preference != null) {
+            preference.setEntries(new CharSequence[]{
+                    mContext.getString(R.string.status_bar_lyric_text_conversion_follow),
+                    mContext.getString(R.string.status_bar_lyric_text_conversion_simplified),
+                    mContext.getString(R.string.status_bar_lyric_text_conversion_traditional)});
+            preference.setEntryValues(new CharSequence[]{"0", "1", "2"});
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final int mode = Settings.Secure.getInt(mContext.getContentResolver(),
+                Settings.Secure.STATUS_BAR_LYRIC_TEXT_CONVERSION, 0 /* def */);
+        ((ListPreference) preference).setValue(String.valueOf(mode));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        Settings.Secure.putInt(mContext.getContentResolver(),
+                Settings.Secure.STATUS_BAR_LYRIC_TEXT_CONVERSION,
+                Integer.parseInt((String) newValue));
+        return true;
+    }
+}
