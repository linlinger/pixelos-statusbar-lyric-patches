+package com.android.settings.display;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+/**
+ * A controller to manage the switch that disguises the device as a Meizu
+ * (Flyme) device for music apps, so they publish the ticker notifications
+ * required by the status bar lyric feature.
+ *
+ * Backed by the system property
+ * {@code persist.sys.disguise_props_for_music_app}, consumed by
+ * MeizuPropsUtils at application instantiation time. The default matches
+ * the framework default ({@code true}); music apps must be restarted
+ * after toggling for the change to take effect.
+ */
+public class StatusBarLyricDisguisePreferenceController extends BasePreferenceController
+        implements PreferenceControllerMixin, Preference.OnPreferenceChangeListener {
+
+    private static final String PROP_DISGUISE_PROPS_FOR_MUSIC_APP =
+            "persist.sys.disguise_props_for_music_app";
+
+    public StatusBarLyricDisguisePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    public StatusBarLyricDisguisePreferenceController(Context context) {
+        super(context, "status_bar_disguise_props_for_music_app");
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        boolean enabled = SystemProperties.getBoolean(
+                PROP_DISGUISE_PROPS_FOR_MUSIC_APP, true /* def */);
+        ((TwoStatePreference) preference).setChecked(enabled);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (Boolean) newValue;
+        SystemProperties.set(PROP_DISGUISE_PROPS_FOR_MUSIC_APP, enabled ? "true" : "false");
+        return true;
+    }
+}
