+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+/**
+ * A controller to manage the switch for showing music lyrics in the status
+ * bar, backed by {@link Settings.Secure#STATUS_BAR_SHOW_LYRIC}.
+ *
+ * The SystemUI side reads this setting via a ContentObserver and renders the
+ * lyric ticker published by supporting music apps.
+ */
+public class StatusBarLyricPreferenceController extends BasePreferenceController
+        implements PreferenceControllerMixin, Preference.OnPreferenceChangeListener {
+
+    public StatusBarLyricPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    public StatusBarLyricPreferenceController(Context context) {
+        super(context, Settings.Secure.STATUS_BAR_SHOW_LYRIC);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        int setting = Settings.Secure.getInt(mContext.getContentResolver(),
+                Settings.Secure.STATUS_BAR_SHOW_LYRIC, 0);
+        ((TwoStatePreference) preference).setChecked(setting != 0);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (Boolean) newValue;
+        Settings.Secure.putInt(mContext.getContentResolver(),
+                Settings.Secure.STATUS_BAR_SHOW_LYRIC, enabled ? 1 : 0);
+        return true;
+    }
+}
